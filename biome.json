{
  "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!docs", "!.claude", "!.design-sync", "!.design-ref"]
  },
  "css": {
    "parser": {
      "cssModules": true,
      "tailwindDirectives": true
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 125
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "warn",
        "noImportCycles": "error",
        "noConsole": "warn"
      },
      "correctness": {
        "noUnusedVariables": "warn",
        "noUnusedFunctionParameters": "warn",
        "noUnusedImports": "warn"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/renderer/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/main/**", "electron", "node:*"],
                    "message": "The renderer runs in the browser sandbox: reach the main process through the HTTP/WS API or the preload bridge, and put shared code in src/shared."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/renderer/lib/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/main/**", "electron", "node:*"],
                    "message": "The renderer runs in the browser sandbox: reach the main process through the HTTP/WS API or the preload bridge, and put shared code in src/shared."
                  },
                  {
                    "group": [
                      "**/features/**",
                      "**/panels/**",
                      "**/components/**",
                      "**/shell/**",
                      "**/hooks/**",
                      "**/app/**",
                      "@/features/**",
                      "@/panels/**",
                      "@/components/**",
                      "@/shell/**",
                      "@/hooks/**",
                      "@/app/**"
                    ],
                    "message": "src/renderer/lib is the renderer's bottom layer: it may import src/shared, other lib modules and packages, never features/panels/components/shell/hooks/app. Move the pure helper down into lib instead."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/main/**", "src/preload.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/renderer/**", "@/**"],
                    "message": "Main and preload must not import renderer code; move what both sides need into src/shared."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/shared/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/main/**", "**/renderer/**", "@/**", "electron", "node:*"],
                    "message": "src/shared is loaded by both processes, so it may only import other src/shared modules and process-neutral packages."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["scripts/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    }
  ]
}
